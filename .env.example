# OPENROUTER_API_KEY: Mandatori untuk menggunakan OpenRouter API.
OPENROUTER_API_KEY=

# GEMINI_API_KEY: Diinjeksi otomatis oleh platform. 
# Dibiarkan untuk kompatibilitas jika nanti ingin ganti balik.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=
